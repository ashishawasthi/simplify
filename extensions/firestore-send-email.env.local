# Read ONLY by the Firebase emulators: a deploy never reads *.local files (like
# functions/.env.local). A bare `firebase emulators:start` runs this extension
# too, and this keeps it away from Gmail: an email written in the emulator goes
# to port 1025 here, and with nothing listening it ends as delivery.state ERROR.
# A local SMTP catcher on port 1025 would show the message instead.
SMTP_CONNECTION_URI=smtp://127.0.0.1:1025
