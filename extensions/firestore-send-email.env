# Config for the Firebase extension "Trigger Email from Firestore"
# (firebase/firestore-send-email), pinned in firebase.json and deployed by hand,
# never by CI (which deploys only functions, rules and the website):
#
#   firebase ext:list --project simplify-special        # compare with firebase.json first
#   firebase deploy --only extensions --project simplify-special
#
# An extensions deploy reconciles every extension at once: one that is
# installed but missing from firebase.json is uninstalled, and its secrets are
# deleted. See docs/operations/cloud-project.md#email.
#
# The same transport as whiz.coach: Gmail submission over implicit TLS,
# authenticating as the Workspace user ashish@whiz.coach with an app password
# of Simplify's own (the secret below; revoking it leaves whiz.coach's mail
# working, and the other way round), sending as its alias contact@whiz.coach.
# whiz.coach's SPF, DKIM and DMARC already cover that address, whichever
# project hands Gmail the message.
#
# smtp.gmail.com:465, not smtp-relay.gmail.com:587: the relay admits servers by
# allowlisted IP, and Cloud Functions leave from changing Google IPs (the relay
# answers "421-4.7.0 Try again later" at EHLO). Authenticate as ashish@, never
# as contact@: an alias has no app password ("534 5.7.9").
#
# The account's limit, about 2,000 recipients a day, is shared with every
# whiz.coach environment; functions/mail.js caps what a sign-up can set off.

AUTH_TYPE=UsernamePassword
SMTP_CONNECTION_URI=smtps://ashish%40whiz.coach@smtp.gmail.com:465
SMTP_PASSWORD=projects/908084220716/secrets/ext-firestore-send-email-SMTP_PASSWORD/versions/latest

# DEFAULT_FROM must be the authenticated account or one of its "Send mail as"
# aliases, or Gmail rewrites the From header. Replies go to contact@whiz.coach.
DEFAULT_FROM=Simplify <contact@whiz.coach>
DEFAULT_REPLY_TO=contact@whiz.coach

MAIL_COLLECTION=mail
DATABASE=(default)
DATABASE_REGION=asia-southeast1
firebaseextensions.v1beta.function/location=asia-southeast1

# functions/mail.js writes a literal `to` and `message`: no templates, and no
# recipients looked up by user id.
USERS_COLLECTION=
TEMPLATES_COLLECTION=

# Sent emails are kept, as in whiz.coach: delivery.state is how a missing one
# is traced.
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
