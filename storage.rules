rules_version = '2';

// Simplify coach platform — class pictures and videos in the Singapore bucket
// (docs/platform/data-model.md). Deny by default; nothing may be listed.
//
//   classes/{code}/pictures/{id}.jpg      anyone may GET the exact path; the class's
//                                         coaches upload (JPEG < 2 MB, never overwrite)
//                                         and delete; admins delete
//   classes/{code}/video-drafts/{id}.mp4  the class's coaches may GET; functions write
//   classes/{code}/videos/{id}.mp4        anyone may GET the exact path; functions write
//
// The Firestore lookups below need the role roles/firebaserules.firestoreServiceAgent
// on the Cloud Storage for Firebase service agent (the CLI offers to grant it on an
// interactive `firebase deploy --only storage`); without it every coach upload fails.
//
// Tests: node tools/test-rules.mjs (starts the emulators itself).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Storage rules may read at most TWO Firestore documents per request, so a
    // class's coach is checked here as: listed in classCoaches/{code}, with a coach
    // profile the admin has not suspended. Whether the class is active is checked
    // by firestore.rules, which decides whether a picture can go on the class's
    // shelf (classes/{code}/pictures/{id}) — and only shelf pictures are ever used.
    function isClassCoach(code) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/classCoaches/$(code)).data.uids
        && firestore.get(/databases/(default)/documents/coaches/$(request.auth.uid)).data
             .get('suspended', false) != true;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /classes/{code}/pictures/{file} {
      allow get: if file.matches('^[A-Za-z0-9_-]{1,40}[.]jpg$');
      // create only, and never over an existing picture (a new id per upload):
      // `resource == null` because an upload to an existing path can be evaluated
      // as a create. The cheap checks come first so a bad upload costs no reads.
      allow create: if resource == null
        && file.matches('^[A-Za-z0-9_-]{1,40}[.]jpg$')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024
        && isClassCoach(code);
      allow delete: if isClassCoach(code) || isAdmin();
    }

    match /classes/{code}/video-drafts/{file} {
      allow get: if isClassCoach(code);
    }

    match /classes/{code}/videos/{file} {
      allow get: if file.matches('^[A-Za-z0-9_-]{1,40}[.]mp4$');
    }
  }
}
